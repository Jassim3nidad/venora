# Venora environment template. Copy to apps/web/.env.local for local web use.
# Keep every secret server-only and replace placeholders outside source control.

# Application identity and public URLs
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public configuration (browser-visible publishable/anon values only)
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>

# Supabase server-only configuration
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# PayMongo server-only test-mode credentials
PAYMONGO_SECRET_KEY=<paymongo-test-secret-key>
PAYMONGO_WEBHOOK_SECRET=<paymongo-test-webhook-secret>

# ---- Money out: PayMongo Treasury / Money Movement ----
# A separate product from Checkout, provisioned per merchant and enabled
# per mode. While disabled, withdrawals fail cleanly and release their
# claimed payouts back to the recipient's available balance.
PAYMONGO_DISBURSEMENTS_ENABLED=false
# Your PayMongo Wallet, sent as the transfer source_account.
# Dashboard > Wallets, or GET /v2/wallets/{wallet_id}.
PAYMONGO_SOURCE_ACCOUNT_NUMBER=<paymongo-wallet-account-number>
PAYMONGO_SOURCE_ACCOUNT_NAME=<registered-business-name>
PAYMONGO_SOURCE_ACCOUNT_BIC=<paymongo-wallet-bic>
# Absolute URL PayMongo calls when a transfer changes state. The payload is
# undocumented, so the handler treats it only as a trigger to re-read
# status from GET /v2/transfers/{id}.
PAYMONGO_CALLBACK_URL=https://your-domain.example/api/webhooks/paymongo-treasury
# Sent as `purpose` on every transfer.
PAYMONGO_TRANSFER_PURPOSE=Disbursement
# auto | instapay | pesonet. `auto` picks per transfer (InstaPay caps at
# PHP 50,000); the explicit values pin every transfer to one rail.
PAYMONGO_TRANSFER_NETWORK_MODE=auto
# Shared secret for POST /api/payouts/reconcile, the scheduled sweep that
# resolves withdrawals left in `processing` by an ambiguous provider
# failure. Without it the endpoint refuses every request.
PAYOUT_RECONCILE_SECRET=<random-reconcile-secret>

# Postgres superuser connection string for the root-level migration
# scripts (push-migrations.js, apply_sql.js). Never commit a real value.
SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Payout account encryption. 32 bytes, base64. Encrypts bank/e-wallet
# identifiers in the app layer so plaintext never reaches Postgres.
# Losing this key makes every stored payout account undecryptable.
#   openssl rand -base64 32
PAYOUT_ENCRYPTION_KEY=<32-byte-base64-payout-encryption-key>

# Resend server-only configuration
RESEND_API_KEY=<resend-test-api-key>
RESEND_FROM=Venora <notifications@example.test>
RSVP_REMINDER_SECRET=<random-rsvp-reminder-secret>

# Web Push server-only configuration
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:operations@example.test

# AI Edge Function secrets and runtime options
OPENROUTER_API_KEY=<openrouter-api-key>

# Notification validation fixtures (test-only; use dedicated non-production data)
NOTIFICATION_TEST_EMAIL=tester@example.test
NOTIFICATION_TEST_PASSWORD=<dedicated-test-password>
NOTIFICATION_TEST_USER_ID=00000000-0000-0000-0000-000000000000

# Playwright role fixtures (test-only)
E2E_CUSTOMER_EMAIL=customer@example.test
E2E_CUSTOMER_PASSWORD=<dedicated-test-password>
E2E_VENUE_EMAIL=venue-owner@example.test
E2E_VENUE_PASSWORD=<dedicated-test-password>
E2E_COORDINATOR_EMAIL=coordinator@example.test
E2E_COORDINATOR_PASSWORD=<dedicated-test-password>
E2E_SUPPLIER_EMAIL=supplier@example.test
E2E_SUPPLIER_PASSWORD=<dedicated-test-password>
E2E_SUPERADMIN_EMAIL=superadmin@example.test
E2E_SUPERADMIN_PASSWORD=<dedicated-test-password>
E2E_ANALYST_ADMIN_EMAIL=analyst-admin@example.test
E2E_ANALYST_ADMIN_PASSWORD=<dedicated-test-password>
E2E_FINANCE_ADMIN_EMAIL=finance-admin@example.test
E2E_FINANCE_ADMIN_PASSWORD=<dedicated-test-password>
