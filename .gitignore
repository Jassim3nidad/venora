.next/
dist/
out/
.turbo/

# Environment variables
.env
.env.local
.env.*.local
apps/web/.env
apps/web/.env.local

# Environment dumps (e.g. `vercel env pull`) — never commit real secrets
.env.*.tmp
.env*.tmp
.env.prod.*
.env.preview.*
.env.development.tmp

# Local-only QA / debugging scripts
*.local-qa.js
check-env.js
qa-verification.js
supplier-qa.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Supabase
supabase/.branches
supabase/.temp

# Test
coverage/
playwright/.auth/
playwright-report/
test-results/
artifacts/ci/
**/e2e/**/*.png
**/e2e/**/*.webm
**/e2e/**/*.zip

# Misc
*.tsbuildinfo
.vercel
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
