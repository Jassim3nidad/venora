NEXT_PUBLIC_SUPABASE_URL=

# CAUTION: this is bundled into public client-side JavaScript. It must be
# ONLY a publishable key (sb_publishable_...) or a legacy anon-role JWT.
# NEVER a secret key (sb_secret_...) or the service-role key — those bypass
# RLS and must never leave server-only environment variables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=

# Optional server-side compatibility aliases used by scripts and Edge Functions.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only — required by payment webhooks and refund processing.
# Never reference this (or any sb_secret_/service-role value) from a
# NEXT_PUBLIC_* variable or a "use client" component.
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (https://dashboard.paymongo.com/developers)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Email delivery (server-only).
RESEND_API_KEY=
RESEND_FROM=Venora <notifications@example.test>

# Web Push (server-only except that the public key is sent to subscribed clients).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@example.test

# AI Edge Functions. Set with `supabase secrets set`, not browser variables.
OPENROUTER_API_KEY=

# Future providers — registering them in
# src/features/payments/infrastructure/register-gateways.ts activates checkout.
# MAYA_SECRET_KEY=
# MAYA_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
